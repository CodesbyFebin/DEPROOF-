{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "const": "deproof-metering-v1"
    },
    "nodeFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string"
    },
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "endpoint": {
      "type": "string"
    },
    "reservedBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "measuredBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "unit": {
      "type": "string"
    },
    "durationNs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "startedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "endedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "outcome": {
      "type": "string"
    },
    "peerAcknowledgment": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "reward": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "assurance": {
      "type": "string"
    }
  },
  "required": [
    "domain",
    "nodeFingerprint",
    "operationId",
    "sequence",
    "endpoint",
    "reservedBytes",
    "measuredBytes",
    "unit",
    "durationNs",
    "startedAt",
    "endedAt",
    "outcome",
    "peerAcknowledgment",
    "reward",
    "assurance"
  ]
}
