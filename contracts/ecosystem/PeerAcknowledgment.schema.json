{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "const": "deproof-peer-ack-v1"
    },
    "producerFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "peerFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string"
    },
    "acceptedBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "observedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "meteringDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "domain",
    "producerFingerprint",
    "peerFingerprint",
    "operationId",
    "acceptedBytes",
    "observedAt",
    "meteringDigest"
  ]
}
