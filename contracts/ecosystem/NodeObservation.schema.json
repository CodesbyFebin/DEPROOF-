{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "deproof-node-observation-v1"
    },
    "nodeFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "hostOS": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "logicalCPUs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "desiredState": {
      "type": "string"
    },
    "observedState": {
      "type": "string"
    },
    "runtimeIdentity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "nodeFingerprint",
    "observedAt",
    "hostOS",
    "architecture",
    "logicalCPUs",
    "desiredState",
    "observedState",
    "runtimeIdentity",
    "limitations"
  ]
}
