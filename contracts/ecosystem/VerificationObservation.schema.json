{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "deproof-proof-verification-v1"
    },
    "proofDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationKeyDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicInputsDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier": {
      "type": "string"
    },
    "trustDomain": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "observedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "proofDigest",
    "verificationKeyDigest",
    "publicInputsDigest",
    "verifier",
    "trustDomain",
    "status",
    "observedAt",
    "limitations"
  ]
}
