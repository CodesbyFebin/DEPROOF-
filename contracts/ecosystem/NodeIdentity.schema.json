{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "deproof-node-identity-v1"
    },
    "publicKeyBase64": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyProtection": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    }
  },
  "required": [
    "schema",
    "publicKeyBase64",
    "fingerprint",
    "keyProtection",
    "createdAt"
  ]
}
