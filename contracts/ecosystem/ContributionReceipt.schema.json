{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "deproof-contribution-v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "producerFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jobId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputCommitment": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resultDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "meteringDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verificationObservation": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "chainObservation": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "assurance": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "domain": {
      "const": "deproof-contribution-v1"
    },
    "nodeFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "job": {
      "$ref": "ProofJob.schema.json"
    },
    "jobEnvelope": {
      "$ref": "SignedProofJob.schema.json"
    },
    "resultManifest": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "id",
    "producerFingerprint",
    "jobId",
    "inputCommitment",
    "resultDigest",
    "meteringDigest",
    "verificationObservation",
    "chainObservation",
    "assurance",
    "createdAt"
  ]
}
