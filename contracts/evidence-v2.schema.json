{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "deproof-evidence-v2"
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "messageSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime": {
            "type": "string"
          },
          "byteLength": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "provenance": {
            "enum": [
              "import",
              "capture"
            ]
          }
        },
        "required": [
          "id",
          "sha256",
          "mime",
          "byteLength",
          "provenance"
        ]
      }
    },
    "note": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "location": {
      "$ref": "location-observation-v1.schema.json"
    }
  },
  "required": [
    "schema",
    "taskId",
    "messageSha256",
    "files",
    "note",
    "createdAt"
  ]
}
