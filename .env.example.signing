# Deproof Release Build Signing Configuration
# DO NOT COMMIT ACTUAL PASSWORDS OR KEYSTORE PATHS
# This file is a TEMPLATE - copy to ~/.deproof-build-env.sh and fill in your values

# Path to keystore file (absolute path recommended)
# Example: /Users/username/.android/deproof-release.jks
# or: /home/username/.android/deproof-release.jks
export DEPROOF_KEYSTORE_PATH="/path/to/deproof-release.jks"

# Keystore password (set when generating keystore with keytool)
# Must be strong: 20+ characters, mixed case, numbers, symbols
# IMPORTANT: Do not use simple passwords
export DEPROOF_KEYSTORE_PASSWORD="your-secure-keystore-password"

# Key alias (identifier used when creating keystore)
# Default: "deproof-key"
# Change only if you used a different alias in keytool
export DEPROOF_KEY_ALIAS="deproof-key"

# Key password (set when generating keystore, can match storepass)
# Must be strong: 20+ characters recommended for security
export DEPROOF_KEY_PASSWORD="your-secure-key-password"

# ============================================================
# USAGE INSTRUCTIONS
# ============================================================

# 1. Generate a new keystore if you don't have one:
#    keytool -genkey -v -keystore deproof-release.jks \
#        -keyalg RSA -keysize 4096 -validity 10950 \
#        -alias deproof-key -storepass "$DEPROOF_KEYSTORE_PASSWORD" \
#        -keypass "$DEPROOF_KEY_PASSWORD"

# 2. Copy this file to your home directory and update values:
#    cp .env.example.signing ~/.deproof-build-env.sh
#    # Edit with your actual keystore path and passwords
#    nano ~/.deproof-build-env.sh

# 3. Make the file readable only by you:
#    chmod 600 ~/.deproof-build-env.sh

# 4. Source before building:
#    source ~/.deproof-build-env.sh
#    ./gradlew assembleRelease

# 5. Verify keystore configuration:
#    keytool -list -v -keystore $DEPROOF_KEYSTORE_PATH -alias $DEPROOF_KEY_ALIAS

# ============================================================
# SECURITY NOTES
# ============================================================

# - NEVER commit this file with actual passwords to git
# - NEVER share passwords via email, chat, or public channels
# - Store passwords in password manager (1Password, LastPass, etc.)
# - Keep keystore file outside the repository
# - Back up keystore file securely (separate from passwords)
# - Restrict file permissions to yourself only (chmod 600)
# - Keep ~/.deproof-build-env.sh out of shell history:
#    Use 'source' with a local file instead of exporting directly

# ============================================================
# CI/CD SETUP (GitHub Actions, GitLab CI, etc.)
# ============================================================

# For automated builds, store these as repository/project secrets:
# - DEPROOF_KEYSTORE_BASE64 (base64-encoded .jks file)
# - DEPROOF_KEYSTORE_PASSWORD
# - DEPROOF_KEY_ALIAS
# - DEPROOF_KEY_PASSWORD

# Example GitHub Actions workflow:
# env:
#   DEPROOF_KEYSTORE_PATH: ${{ runner.temp }}/deproof-release.jks
#   DEPROOF_KEYSTORE_PASSWORD: ${{ secrets.DEPROOF_KEYSTORE_PASSWORD }}
#   DEPROOF_KEY_ALIAS: ${{ secrets.DEPROOF_KEY_ALIAS }}
#   DEPROOF_KEY_PASSWORD: ${{ secrets.DEPROOF_KEY_PASSWORD }}
