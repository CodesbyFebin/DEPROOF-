{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "latitude": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    },
    "longitude": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    },
    "accuracyMeters": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    },
    "provider": {
      "enum": [
        "gps",
        "network",
        "fused"
      ]
    },
    "permission": {
      "enum": [
        "APPROXIMATE",
        "PRECISE"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mock": {
      "type": "boolean"
    }
  },
  "required": [
    "latitude",
    "longitude",
    "accuracyMeters",
    "provider",
    "permission",
    "observedAt",
    "collectedAt",
    "mock"
  ]
}
