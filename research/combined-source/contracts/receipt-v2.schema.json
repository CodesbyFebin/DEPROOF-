{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "deproof-receipt-v2"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "REJECTED",
        "OBSERVED",
        "LOCAL_EVIDENCE_SIGNED",
        "WALLET_SIGNED",
        "SUBMITTED"
      ]
    },
    "account": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "network": {
      "anyOf": [
        {
          "enum": [
            "devnet",
            "mainnet-beta"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "cardHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "messageSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentMessageSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewContextHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "deproof-evidence-v2"
            },
            "taskId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "messageSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "files": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mime": {
                    "type": "string"
                  },
                  "byteLength": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "provenance": {
                    "enum": [
                      "import",
                      "capture"
                    ]
                  }
                },
                "required": [
                  "id",
                  "sha256",
                  "mime",
                  "byteLength",
                  "provenance"
                ]
              }
            },
            "note": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
            }
          },
          "required": [
            "schema",
            "taskId",
            "messageSha256",
            "files",
            "note",
            "createdAt"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "localSignature": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": {
              "const": "deproof-evidence-sig-v2"
            },
            "algorithm": {
              "const": "SHA256withECDSA"
            },
            "envelopeBase64": {
              "type": "string"
            },
            "signatureDerBase64": {
              "type": "string"
            },
            "spkiBase64": {
              "type": "string"
            },
            "aliasVersion": {
              "type": "string"
            },
            "securityLevel": {
              "enum": [
                "STRONGBOX",
                "TRUSTED_ENVIRONMENT",
                "HARDWARE_UNSPECIFIED",
                "SOFTWARE",
                "UNAVAILABLE"
              ]
            },
            "qualification": {
              "type": "string"
            }
          },
          "required": [
            "domain",
            "algorithm",
            "envelopeBase64",
            "signatureDerBase64",
            "spkiBase64",
            "aliasVersion",
            "securityLevel",
            "qualification"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NOT_SUBMITTED",
            "SUBMITTING",
            "SUBMITTED",
            "SUBMISSION_UNKNOWN"
          ]
        },
        "submittedByDeproof": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "broadcast": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rpcAcceptedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "submittedByDeproof",
        "broadcast",
        "attemptedAt",
        "rpcAcceptedAt"
      ]
    },
    "chainObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "NOT_QUERIED"
          ]
        },
        "lastKnownStatus": {
          "enum": [
            "UNKNOWN",
            "PROCESSED",
            "CONFIRMED",
            "FINALIZED",
            "FAILED"
          ]
        },
        "slot": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockTime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {}
      },
      "required": [
        "availability",
        "lastKnownStatus",
        "slot",
        "blockTime",
        "observedAt",
        "error"
      ]
    },
    "policyVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decoderVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "taskId",
    "outcome",
    "account",
    "network",
    "summary",
    "cardHash",
    "messageSha256",
    "currentMessageSha256",
    "reviewContextHash",
    "evidenceDigest",
    "manifest",
    "signature",
    "localSignature",
    "submission",
    "chainObservation",
    "policyVersion",
    "decoderVersion",
    "createdAt",
    "limitations"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "signature": {
            "type": "null"
          },
          "submission": {
            "properties": {
              "state": {
                "const": "NOT_SUBMITTED"
              },
              "broadcast": {
                "const": false
              },
              "submittedByDeproof": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "OBSERVED"
          }
        }
      },
      "then": {
        "properties": {
          "submission": {
            "properties": {
              "state": {
                "const": "NOT_SUBMITTED"
              },
              "broadcast": {
                "const": false
              },
              "submittedByDeproof": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
