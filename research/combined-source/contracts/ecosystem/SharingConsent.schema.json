{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string"
    },
    "capBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "reservedBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "measuredBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "bytesPerSecond": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    }
  },
  "required": [
    "enabled",
    "endpoint",
    "capBytes",
    "reservedBytes",
    "measuredBytes",
    "bytesPerSecond",
    "deadline"
  ]
}
