    return if (decimals == 0) s else s.dropLast(decimals) + \".\" + s.takeLast(decimals)
}
fun formatSol(raw: BigInteger) = formatAmount(raw, 9)
fun formatSkr(raw: BigInteger) = formatAmount(raw, 6)
