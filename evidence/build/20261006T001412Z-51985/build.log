fi

git status --short > "$OUT/git-status-after.txt"

if test -s "$OUT/build-report.md"; then
  cat "$OUT/build-report.md"
fi

printf '\nRun evidence: %s\n' "$OUT"
printf '%s\n' \
  'Execution completion does not establish production qualification.'

