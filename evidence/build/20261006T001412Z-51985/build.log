fun sha256Text(s: String) = sha256Hex(s.toByteArray(Charsets.UTF_8))
fun formatAmount(raw: BigInteger, decimals: Int): String {
    ensure(raw.signum() >= 0 && decimals in 0..18, \"BAD_AMOUNT\")
