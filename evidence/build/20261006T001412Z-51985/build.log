if(search){const rows=[...document.querySelectorAll('tr[data-search]')];const update=()=>{let count=0;for(const row of rows){row.hidden="'!row.dataset.search.includes(search.value.toLowerCase());if(!row.hidden)count++;}document.querySelector('"'#filter-count').textContent="'`${count} of 120 base features shown`;};search.addEventListener('"'input',update);update();}
const inspect=document.querySelector('#inspect');
if(inspect){const text=document.querySelector('#receipt-text'),out=document.querySelector('#inspection');document.querySelector('#receipt-file').addEventListener('change',async e=>{const f=e.target.files[0];if("'!f)return;if(f.size>2*1024*1024){out.textContent='"'FILE_TOO_LARGE';return;}text.value=await f.text();});inspect.addEventListener('click',()=>{try{if(text.value.length>2*1024*1024)throw new Error('JSON_TOO_LARGE');const value=JSON.parse(text.value),r=value.schema==='deproof-portable-event-v1'?value.event:value;if(r.schema"'!=='"'deproof-receipt-v2')throw new Error('UNSUPPORTED_SCHEMA');if("'!r.submission||!r.chainObservation)throw new Error('"'MISSING_PROVENANCE');if(r.outcome==='REJECTED'&&(r.signature"'!==null||r.submission.broadcast!==false||r.submission.submittedByDeproof!==false))throw new Error('"'REJECTION_PROVENANCE_CONFLICT');out.textContent=JSON.stringify({inspection:'Display only; cryptographic verification requires tools/verify.py',outcome:r.outcome,network:r.network,account:r.account,submission:r.submission,chainObservation:r.chainObservation,messageSha256:r.messageSha256,evidenceDigest:r.evidenceDigest,localSignature:r.localSignature?'Present, not verified in this browser':'Absent',limitations:r.limitations},null,2);}catch(e){out.textContent="'`Cannot inspect: ${e.message}`;}});}
