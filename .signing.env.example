# .signing.env.example — copy to .signing.env and fill in real values.
# .signing.env is gitignored. Never commit the real .signing.env.
#
# Usage: source .signing.env && bash scripts/sign-apk.sh

export DEPROOF_KEYSTORE_PATH=/home/codesbyfebin/keys/deproof-release.jks
export DEPROOF_KEY_ALIAS=deproof-key
export DEPROOF_KEYSTORE_PASSWORD=your-keystore-password-here
export DEPROOF_KEY_PASSWORD=your-key-password-here
